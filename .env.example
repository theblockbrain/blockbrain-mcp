# ============================================================================
# blockbrain-mcp — example environment configuration
# Copy to `.env` and fill in your own values.
# ============================================================================

# ─── Identity Provider ──────────────────────────────────────────────────────
# Pick ONE of the three paths below. See docs/PROVIDERS.md for per-provider
# walk-throughs (Entra ID, Zitadel, Auth0, Okta, Keycloak).

# --- A. Entra ID (Azure AD) — Single-Tenant [RECOMMENDED DEFAULT] -----------
# Get the Directory (tenant) ID from Azure Portal → App registration → Overview
AZURE_TENANT_ID=

# --- B. Entra ID — Multi-Tenant with explicit allow-list --------------------
# Leave AZURE_TENANT_ID empty and instead set:
#   AZURE_TENANT_ID=common
#   AZURE_ALLOWED_TENANTS=<tenant-a-uuid>,<tenant-b-uuid>
AZURE_ALLOWED_TENANTS=

# --- C. Any other OIDC provider (Zitadel, Auth0, Okta, Keycloak, ...) -------
# Leave AZURE_TENANT_ID empty, set:
#   OIDC_ISSUER_URL=https://auth.example.com
# Optional (derived from the issuer when omitted):
#   OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
OIDC_ISSUER_URL=
OIDC_JWKS_URI=

# ─── Local testing (MCP Inspector) ──────────────────────────────────────────
# DANGER: disables OAuth/JWT auth entirely — the /mcp endpoint then accepts
# unauthenticated requests. Only for local testing with the MCP Inspector
# (no Azure/Entra, no tunnel needed). Default is false (auth enforced).
# NEVER enable this in a deployed or network-exposed setup.
MCP_AUTH_DISABLED=false

# ─── Resource Server Identity ───────────────────────────────────────────────
# Must match the `aud` claim issued to this server.
#   Entra:         the Application ID URI you set under "Expose an API"
#                  e.g. api://blockbrain-mcp
#   Others:        an absolute URL identifying this server
#                  e.g. https://mcp.example.com
MCP_RESOURCE_IDENTIFIER=

# Comma-separated required scopes. Example for Entra: mcp.access
# These are published in this server's RFC 9728 Protected Resource Metadata,
# which is where an MCP client should read them from.
MCP_REQUIRED_SCOPES=

# Also copy the scopes into the proxied authorization server metadata at
# /.well-known/oauth-authorization-server. On by default so clients that read
# scopes only from that document keep working. Set to false if you want the
# proxied document to carry nothing beyond what the upstream IdP published.
MCP_ADVERTISE_SCOPES_IN_AS_METADATA=true

# Advertise `<resource>/.default` when MCP_REQUIRED_SCOPES is empty. Entra then
# bundles every admin-consented scope for the resource, which is far wider than
# any single server needs. Pin MCP_REQUIRED_SCOPES instead wherever you can.
MCP_ALLOW_DEFAULT_SCOPE=false

# ─── Server ─────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=Blockbrain MCP Template
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_LOG_LEVEL=INFO

# Public URL Blockbrain uses to reach this server.
#   • `make serve` sets this automatically to the cloudflared tunnel URL.
#   • When running `make dev` alone (no tunnel), set this manually for prod or
#     to override the local URL.
#   • Required when MCP_RESOURCE_IDENTIFIER is not an http(s) URL.
MCP_PUBLIC_BASE_URL=

# ─── Tool-specific (⭐ CUSTOMIZE HERE — one block per tool) ─────────────────
# Brave Search API key — https://brave.com/search/api/ (2000 req/month free)
BRAVE_API_KEY=

# research_topic: daily per-user cap
RATE_LIMIT_RESEARCH_PER_DAY=50

# read_url / research_topic outbound fetch guard.
# https is required and private, loopback, link-local and other reserved
# address ranges are always rejected, on the initial URL and on every redirect.
# Set an allow-list to narrow it further to hosts you know (subdomains included).
READ_URL_ALLOWED_DOMAINS=

# Byte cap on a fetched response body.
READ_URL_MAX_BYTES=2000000

# Character cap on the extracted Markdown handed back to the model.
READ_URL_MAX_CHARS=100000
